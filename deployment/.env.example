# Copy to .env.production. This is data, not shell code; values are literal.
SSH_HOST=
SSH_PORT=22
PROVISION_USER=root
SSH_USER=silodev
DEPLOY_PUBLIC_KEY_PATH=deployment/github_deploy_key.pub
SSH_PRIVATE_KEY_PATH=deployment/github_deploy_key
# Repository receiving the production environment; paths are repo-relative or absolute.
GITHUB_REPO=niklucky/silo
# Empty uses ~/.ssh/known_hosts. Connect to the VPS and verify its key first.
SSH_KNOWN_HOSTS_PATH=
DOMAIN=silo.warpunit.com
# Optional; an existing Let's Encrypt account is reused.
CERT_EMAIL=
SILO_UID=10001
SILO_GID=10001
SERVER_PORT=8787
BACKUP_KEEP_DAYS=14
