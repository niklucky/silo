{
  "name": "@secret/extension",
  "description": "Secret browser extension: autofill for logins, cards and HTTP Basic Auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "pnpm -w run build:wasm",
    "dev": "pnpm run wasm && wxt",
    "dev:firefox": "pnpm run wasm && wxt -b firefox",
    "build": "pnpm run wasm && wxt build",
    "build:firefox": "pnpm run wasm && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@secret/bindings": "workspace:*",
    "@secret/ui": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
